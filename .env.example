OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_REASONING=medium
SITE_URL=https://lumina-frameworks.com

# Contact form (Resend) — emails Aliff + Amir with branded HTML
RESEND_API_KEY=
CONTACT_FROM=Lumina Frameworks <hello@lumina-frameworks.com>

# Admin panel (Google Sign-In)
# GOOGLE_CLIENT_ID: OAuth 2.0 Web client ID from Google Cloud Console.
#   Add http://127.0.0.1:8788 and https://lumina-frameworks.com as authorised
#   JavaScript origins. No client secret is needed for the ID-token flow.
GOOGLE_CLIENT_ID=
# Any long random string. Rotating it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Comma-separated allowlist of admin Google accounts.
ADMIN_EMAILS=amirhafizi443@gmail.com,aliffprime3@gmail.com

# Public base URL of the R2 media bucket (also set in wrangler.toml [vars])
MEDIA_BASE_URL=https://media.lumina-frameworks.com
